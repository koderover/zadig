param(
    [Parameter(Mandatory=$true)][string]$ServerUrl,
    [Parameter(Mandatory=$true)][string]$ResourceUrl,
    [Parameter(Mandatory=$true)][string]$Token,
    [ValidateSet('amd64','arm64')][string]$Arch,
    [string]$ServiceUser,
    [PSCredential]$ServiceCredential,
    [string]$WorkDir,
    [bool]$AutoStart = $true,
    [switch]$Upgrade
)
$ErrorActionPreference = 'Stop'
if (([uri]$ServerUrl).Scheme -notin @('http','https') -or ([uri]$ResourceUrl).Scheme -notin @('http','https')) { throw 'Server and resources must use HTTP(S)' }
$principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Run PowerShell as administrator' }
$nativeArch = $env:PROCESSOR_ARCHITEW6432
if (-not $nativeArch) { $nativeArch = $env:PROCESSOR_ARCHITECTURE }
switch ($nativeArch.ToUpperInvariant()) {
    'AMD64' { $detected = 'amd64' }
    'ARM64' { $detected = 'arm64' }
    default { throw 'Unsupported CPU architecture' }
}
if ($Arch -and $Arch -ne $detected) { throw 'Selected architecture does not match this host' }
switch ($detected) {
{{range .Assets}}{{if eq .OS "windows"}}    '{{.Arch}}' { $file = '{{.Filename}}'; $sha = '{{.SHA256}}' }
{{end}}{{end}}    default { throw 'No release for this host' }
}
if ($AutoStart -and $ServiceUser -ne 'LocalSystem') {
    if (-not $ServiceCredential) {
        $account = $ServiceUser
        if (-not $account) { $account = [Security.Principal.WindowsIdentity]::GetCurrent().Name }
        $ServiceCredential = Get-Credential -UserName $account -Message 'Windows Service account credentials (password is not saved in agent files)'
    }
    if (-not $ServiceCredential) { throw 'Service credentials are required, or explicitly select -ServiceUser LocalSystem' }
    $ServiceUser = $ServiceCredential.UserName
}
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$tmp = Join-Path ([IO.Path]::GetTempPath()) ([Guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Path $tmp | Out-Null
$destination = Join-Path $HOME 'zadig-agent.exe'
$staged = "$destination.install-$([Guid]::NewGuid().ToString('N')).exe"
try {
    $candidate = Join-Path $tmp 'zadig-agent.exe'
    Invoke-WebRequest -UseBasicParsing -Uri "$($ResourceUrl.TrimEnd('/'))/$file" -OutFile $candidate
    if ((Get-FileHash -Algorithm SHA256 -LiteralPath $candidate).Hash.ToLowerInvariant() -ne $sha) { throw 'Agent checksum mismatch' }
    $manifest = Join-Path $tmp 'manifest.json'
    Invoke-WebRequest -UseBasicParsing -Uri "$($ResourceUrl.TrimEnd('/'))/zadig-agent-v{{.Version}}.manifest.json" -OutFile $manifest
    Invoke-WebRequest -UseBasicParsing -Uri "$($ResourceUrl.TrimEnd('/'))/zadig-agent-v{{.Version}}.manifest.json.sig" -OutFile "$manifest.sig"
    & $candidate verify-release --manifest $manifest
    if ($LASTEXITCODE -ne 0) { throw 'Signed release verification failed' }
    if (Test-Path -LiteralPath $destination) {
        if (-not $Upgrade) { throw 'Agent already exists. Use Zadig self upgrade, or the manual upgrade command.' }
        if ((Get-Item -LiteralPath $destination).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Refusing to replace a linked agent file' }
        & $destination stop
        if ($LASTEXITCODE -ne 0) { throw 'Could not stop the existing agent' }
        $service = Get-Service -Name zadig-agent -ErrorAction SilentlyContinue
        if ($service -and $service.Status -ne 'Stopped') { Stop-Service -Name zadig-agent; $service.WaitForStatus('Stopped', [TimeSpan]::FromSeconds(60)) }
        & $candidate verify-release --manifest $manifest --wait-for-stop
        if ($LASTEXITCODE -ne 0) { throw 'Existing agent has not stopped' }
        $backup = "$destination.previous-$([Guid]::NewGuid().ToString('N'))"
        $deadline = [DateTime]::UtcNow.AddSeconds(60)
        while ($true) {
            try { Move-Item -LiteralPath $destination -Destination $backup; break }
            catch { if ([DateTime]::UtcNow -ge $deadline) { throw }; Start-Sleep -Seconds 1 }
        }
        Write-Host "Previous executable: $backup"
    }
    Copy-Item -LiteralPath $candidate -Destination $staged
    Move-Item -LiteralPath $staged -Destination $destination
    $agentArgs = @('install', '--server-url', $ServerUrl, '--token', $Token, "--auto-start=$($AutoStart.ToString().ToLowerInvariant())")
    if ($WorkDir) { $agentArgs += @('--work-dir', $WorkDir) }
    if ($ServiceUser) { $agentArgs += @('--service-user', $ServiceUser) }
    if ($ServiceCredential -and $AutoStart) {
        $plain = $ServiceCredential.GetNetworkCredential().Password
        $previousEncoding = $OutputEncoding
        try {
            $OutputEncoding = [System.Text.UTF8Encoding]::new($false)
            $plain | & $destination @agentArgs --password-stdin
        } finally { $plain = $null; $OutputEncoding = $previousEncoding }
    } else { & $destination @agentArgs }
    if ($LASTEXITCODE -ne 0) { throw 'Agent installation/start failed; check the error above before retrying' }
} finally {
    Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $staged -Force -ErrorAction SilentlyContinue
}
