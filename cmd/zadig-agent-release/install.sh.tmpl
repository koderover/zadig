#!/bin/sh
set -eu
server= resource= token= platform= architecture= service_user= workdir=
auto_start=true
upgrade=false
while [ "$#" -gt 0 ]; do
  [ "$#" -ge 2 ] || { echo "Missing value for $1" >&2; exit 1; }
  case "$1" in
    --server-url) server=$2 ;;
    --resource-url) resource=$2 ;;
    --token) token=$2 ;;
    --os) platform=$2 ;;
    --arch) architecture=$2 ;;
    --service-user) service_user=$2 ;;
    --work-dir) workdir=$2 ;;
    --auto-start) auto_start=$2 ;;
    --upgrade) upgrade=$2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
  shift 2
done
[ -n "$server" ] && [ -n "$resource" ] && [ -n "$token" ] || { echo "--server-url, --resource-url and --token are required" >&2; exit 1; }
case "$server" in http://*|https://*) ;; *) echo "Zadig server must use HTTP(S)" >&2; exit 1 ;; esac
case "$resource" in http://*|https://*) ;; *) echo "Resource URL must use HTTP(S)" >&2; exit 1 ;; esac
case "$auto_start:$upgrade" in true:true|true:false|false:true|false:false) ;; *) echo "Boolean options require true or false" >&2; exit 1 ;; esac
case "$(uname -s)" in Linux) detected_os=linux ;; Darwin) detected_os=darwin ;; *) echo "Unsupported operating system" >&2; exit 1 ;; esac
case "$(uname -m)" in x86_64|amd64) detected_arch=amd64 ;; aarch64|arm64) detected_arch=arm64 ;; *) echo "Unsupported CPU architecture" >&2; exit 1 ;; esac
[ -z "$platform" ] || [ "$platform" = "$detected_os" ] || { echo "Selected operating system does not match this host" >&2; exit 1; }
[ -z "$architecture" ] || [ "$architecture" = "$detected_arch" ] || { echo "Selected architecture does not match this host" >&2; exit 1; }
case "$detected_os/$detected_arch" in
{{range .Assets}}{{if ne .OS "windows"}}  {{.OS}}/{{.Arch}}) file='{{.Filename}}' ;;
{{end}}{{end}}  *) echo "No release for this host" >&2; exit 1 ;;
esac
[ "$(id -u)" -eq 0 ] || { echo "Run this installer with sudo/root to configure boot startup" >&2; exit 1; }
tmp=$(mktemp -d)
staged=
trap 'rm -rf "$tmp"; if [ -n "$staged" ]; then rm -f "$staged"; fi' EXIT
trap 'exit 1' HUP INT TERM
fetch() {
  case "$1" in https://*) protocols='=https' ;; *) protocols='=http,https' ;; esac
  if [ -n "${ZADIG_AGENT_UPGRADE_CA_FILE:-}" ]; then
    curl --proto "$protocols" --proto-redir "$protocols" --cacert "$ZADIG_AGENT_UPGRADE_CA_FILE" -fsSL "$1" -o "$2"
  else
    curl --proto "$protocols" --proto-redir "$protocols" -fsSL "$1" -o "$2"
  fi
}
fetch "${resource%/}/$file" "$tmp/zadig-agent"
chmod 700 "$tmp/zadig-agent"
destination=/usr/local/bin/zadig-agent
backup=
if [ -e "$destination" ] || [ -L "$destination" ]; then
  [ "$upgrade" = true ] || { echo "Agent already exists. Use Zadig self upgrade, or the manual upgrade command." >&2; exit 1; }
  [ -f "$destination" ] && [ ! -L "$destination" ] || { echo "Refusing to replace a non-regular agent file" >&2; exit 1; }
  "$destination" stop
  sleep 6
  "$tmp/zadig-agent" wait-for-stop
  backup="$destination.previous-$(date +%s)-$$"
fi
mkdir -p /usr/local/bin
staged=$(mktemp /usr/local/bin/.zadig-agent-install-XXXXXX)
cp "$tmp/zadig-agent" "$staged"
chmod 755 "$staged"
if [ -n "$backup" ]; then cp -p "$destination" "$backup"; fi
mv -f "$staged" "$destination"
staged=
set -- "$destination" install --server-url "$server" --token "$token" "--auto-start=$auto_start"
if [ -n "$service_user" ]; then set -- "$@" --service-user "$service_user"; fi
if [ -n "$workdir" ]; then set -- "$@" --work-dir "$workdir"; fi
if ! "$@"; then
  echo "Agent installation/start failed. Previous executable: ${backup:-none}. Check the error above before retrying." >&2
  exit 1
fi
